<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head.ejs') %>
    <title>My Blog</title>
  </head>
  <body>
    <main>
      <%- include('partials/header.ejs') %>
      <h2>Recent Posts</h2>
      <section class="posts">
        <% for(var i = 0; i < posts.length; i++) { %>
        <div class="post-summary">
          <a href="/posts/<%= posts[i].slug %>">
            <h3><%= posts[i].title %></h3>
          </a>
          <p>Posted on <%= new Date(posts[i].date).toLocaleDateString() %></p>
          <p><%= posts[i].description %></p>
        </div>
        <% } %>
      </section>
      <%- include('partials/footer.ejs') %>
    </main>
  </body>
</html>
